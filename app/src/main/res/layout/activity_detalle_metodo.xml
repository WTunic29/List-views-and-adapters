<?xml version="1.0" encoding="utf-8"?>

<ScrollView

    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"

    >

    <LinearLayout

        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp"

        >

        <TextView

            android:id="@+id/methodNameTextView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Nombre del método"
            android:textAlignment="center"
            android:textSize="28sp"
            android:textStyle="bold"

            />

        <TextView

            android:id="@+id/methodDescriptionTextView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"

            android:layout_marginTop="24dp"
            android:text="Descripción del método"
            android:textSize="18sp"

            />

        <TextView

            android:id="@+id/methodExtractionTextView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"

            android:layout_marginTop="24dp"
            android:text="Tipo de extracción:"
            android:textSize="16sp"

            />

        <TextView

            android:id="@+id/methodProfileTextView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"

            android:layout_marginTop="12dp"
            android:text="Perfil:"
            android:textSize="16sp"

            />

    </LinearLayout>

</ScrollView>
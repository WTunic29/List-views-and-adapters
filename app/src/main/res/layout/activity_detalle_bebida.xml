<?xml version="1.0" encoding="utf-8"?>

<ScrollView

    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"

    >

    <LinearLayout

        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp"

        >

        <TextView
            android:id="@+id/drinkNameTextView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"

            android:text="Nombre de la bebida"
            android:textAlignment="center"
            android:textSize="28sp"
            android:textStyle="bold"

            />

        <TextView

            android:id="@+id/drinkDescriptionTextView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"

            android:layout_marginTop="24dp"
            android:text="Descripción de la bebida"
            android:textSize="18sp" />

        <TextView

            android:id="@+id/drinkMethodTextView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"

            android:layout_marginTop="24dp"
            android:text="Método:"
            android:textSize="16sp"

            />

        <TextView

            android:id="@+id/drinkProfileTextView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"

            android:layout_marginTop="12dp"
            android:text="Perfil:"
            android:textSize="16sp"

            />

        <TextView

            android:id="@+id/drinkBodyTextView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"

            android:layout_marginTop="12dp"
            android:text="Cuerpo:"
            android:textSize="16sp"

            />

    </LinearLayout>

</ScrollView>